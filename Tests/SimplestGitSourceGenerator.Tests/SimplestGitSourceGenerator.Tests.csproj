<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsPackable>false</IsPackable>
        <PublishRepositoryUrl>true</PublishRepositoryUrl>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.8.0" PrivateAssets="all" />
        <PackageReference Include="TUnit" Version="1.76.0" />
    </ItemGroup>

    <Import Project="..\..\Src\SimplestGitSourceGenerator\build\SimplestGitSourceGenerator.targets" />

    <ItemGroup>
        <ProjectReference Include="..\..\Src\SimplestGitSourceGenerator\SimplestGitSourceGenerator.csproj" OutputItemType="Analyzer" />
        <None Include="..\..\Src\SimplestGitSourceGenerator\build\SimplestGitSourceGenerator.targets" Link="SimplestGitSourceGenerator.targets" CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>

</Project>